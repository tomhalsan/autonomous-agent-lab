ight="50" as="geometry" /></mxCell><mxCell id="step_3" value="&lt;span style='font-size:9px;color:#4338ca;'&gt;&lt;b&gt;3. CANDIDATE DISCOVERY&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;b&gt;Evaluate Registry &amp;amp; Heartbeats&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#64748b;'&gt;LivenessPolicy (READY &amp;amp; Fresh)&lt;/span&gt;" parent="1" vertex="1" style="rounded=1;fillColor=#ffffff;strokeColor=#818cf8;strokeWidth=1;align=center;verticalAlign=middle;fontColor=#0f172a;fontSize=11;"><mxGeometry x="625" y="326" width="215" height="50" as="geometry" /></mxCell><mxCell id="step_4" value="&lt;span style='font-size:9px;color:#4338ca;'&gt;&lt;b&gt;4. AGENT SELECTION&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;b&gt;Deterministic Selection Policy&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#64748b;'&gt;Selected Agent &amp;amp; Target Queue&lt;/span&gt;" parent="1" vertex="1" style="rounded=1;fillColor=#ffffff;strokeColor=#818cf8;strokeWidth=1;align=center;verticalAlign=middle;fontColor=#0f172a;fontSize=11;"><mxGeometry x="875" y="326" width="215" height="50" as="geometry" /></mxCell><mxCell id="n_orch_infra" value="&lt;b&gt;Infrastructure Layer — RedisGateway&lt;/b&gt;&lt;br/&gt;&lt;span style='font-weight:normal;color:#14532d;font-size:10px;'&gt;Implements Abstract Ports: TaskDispatcher, StateReader, RoutingRecorder, ResultReader, EventPublisher&lt;/span&gt;" parent="1" vertex="1" style="rounded=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1;align=center;verticalAlign=middle;fontColor=#166534;fontSize=11;"><mxGeometry x="110" y="394" width="980" height="38" as="geometry" /></mxCell><mxCell id="n_redis_box" value="&lt;b&gt;REDIS TRANSPORT &amp;amp; STATE STORE (Docker: redis | redis:7-alpine | AOF Persistence)&lt;/b&gt;" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#9f1239;fontSize=12;"><mxGeometry x="90" y="500" width="1020" 