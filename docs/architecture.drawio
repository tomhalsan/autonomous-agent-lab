<mxfile host="Antigravity" modified="2026-11-06T00:00:00.000Z" agent="Antigravity" version="24.0.0" type="device"><diagram id="autonomous-agent-lab-arch" name="Autonomous Agent Lab Architecture"><mxGraphModel dx="1200" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_title" value="&lt;b&gt;Autonomous Agent Lab — System Architecture&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;font-weight:normal;color:#64748b;'&gt;Capability-Routed Multi-Agent Platform with Asynchronous Redis Transport &amp;amp; Grounded Inference&lt;/span&gt;" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#0f172a;"><mxGeometry x="200" y="20" width="800" height="45" as="geometry" /></mxCell><mxCell id="n_user" value="&lt;b&gt;Operator / Browser User&lt;/b&gt;" parent="1" vertex="1" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0f172a;fontSize=12;"><mxGeometry x="480" y="78" width="240" height="36" as="geometry" /></mxCell><mxCell id="n_console" value="&lt;b&gt;Prototype Console (Presentation UI • SPA)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#0284c7;'&gt;Task Submission • Live Routing Progression • Grounded Results &amp;amp; Attribution&lt;/span&gt;" parent="1" vertex="1" style="rounded=1;arcSize=10;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0369a1;fontSize=12;"><mxGeometry x="360" y="138" width="480" height="48" as="geometry" /></mxCell><mxCell id="n_orch_box" value="&lt;b&gt;ORCHESTRATOR CONTAINER (Docker: orchestrator | Port 8080)&lt;/b&gt;" parent="1" vertex="1" style="rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#1e293b